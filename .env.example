APP_NAME=NextStep
APP_ENV=development
# For a separately served local UI, add its origin, for example:
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
DATABASE_URL=sqlite:///data/nextstep.db
CORS_ORIGINS=
ADMIN_API_KEY=
AI_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=15
AI_MAX_TOKENS=300
AI_TEMPERATURE=0
AI_CACHE_TTL_SECONDS=86400
SYNC_ON_START=false
DATA_SOURCE_URLS=
ALLOWED_STATES=AP,AR,AS,BR,CG,GA,GJ,HR,HP,JH,KA,KL,MP,MH,MN,ML,MZ,NL,OD,PB,RJ,SK,TN,TS,TR,UP,UK,WB,AN,CH,DN,DL,JK,LA,LD,PY,ALL
RATE_LIMIT_PER_MINUTE=60
REQUEST_BODY_LIMIT_BYTES=32768
SYNC_TIMEOUT_SECONDS=15
AUDIT_LOG_RETENTION_DAYS=365
AUTH_SECRET=change-this-to-a-long-random-secret
AUTH_SESSION_HOURS=24